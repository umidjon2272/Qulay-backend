generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MemoryCategory {
  PROFILE
  PREFERENCE
  CONTACT
  GOAL
  WORK
  OTHER
}

enum UsageType {
  TEXT
  VOICE
  TOOL
  FILE
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  avatarUrl     String?
  role          UserRole       @default(USER)
  status        UserStatus     @default(ACTIVE)
  timezone      String         @default("UTC")
  language      String         @default("en")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  tasks         Task[]
  reminders     Reminder[]
  meetings      Meeting[]
  notes         Note[]
  conversations Conversation[]
  memories      UserMemory[]
  aiUsage       AiUsage[]
  activityLogs  ActivityLog[]
}

model RefreshToken {
  id               String    @id @default(uuid()) @db.Uuid
  tokenHash        String
  // Deterministic lookup key avoids bcrypt-scanning every active session.
  // Nullable keeps refresh compatibility with rows created before this migration.
  tokenFingerprint String?   @db.Char(64)
  userId           String    @db.Uuid
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, tokenFingerprint, revokedAt, expiresAt])
  @@index([expiresAt])
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  title       String       @db.VarChar(200)
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, dueDate])
  @@index([userId, createdAt])
}

model Reminder {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  title       String         @db.VarChar(200)
  description String?        @db.Text
  remindAt    DateTime
  status      ReminderStatus @default(ACTIVE)
  priority    TaskPriority   @default(MEDIUM)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, remindAt])
  @@index([userId, priority])
}

model Meeting {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @db.Uuid
  title                 String        @db.VarChar(200)
  description           String?       @db.Text
  participant           String?       @db.VarChar(200)
  startsAt              DateTime
  endsAt                DateTime
  reminderMinutesBefore Int           @default(15)
  status                MeetingStatus @default(SCHEDULED)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@index([userId, status])
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String   @db.VarChar(200)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String    @db.VarChar(200)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole  @default(USER)
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model UserMemory {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  key        String         @db.VarChar(100)
  value      String         @db.Text
  category   MemoryCategory @default(OTHER)
  importance Int            @default(5)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, category])
  @@index([userId, createdAt])
}

model AiUsage {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  type          UsageType
  model         String?   @db.VarChar(100)
  inputTokens   Int       @default(0)
  outputTokens  Int       @default(0)
  audioSeconds  Float     @default(0)
  estimatedCost Float     @default(0)
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, createdAt])
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, action])
  @@index([entityType, entityId])
}
