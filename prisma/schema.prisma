generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MemoryType {
  PERSONAL
  BUSINESS
  CONTACT
  PREFERENCE
  DECISION
  GOAL
  CONTEXT
}

enum UsageType {
  TEXT
  VOICE
  TOOL
  FILE
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
}

enum FinanceCategoryType {
  INCOME
  EXPENSE
  BOTH
}

enum FinanceCurrency {
  UZS
  USD
}

enum TelegramConnectionStatus {
  DISCONNECTED
  AWAITING_CODE
  AWAITING_PASSWORD
  CONNECTED
  ERROR
}

enum GoogleConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum NotificationType {
  TASK
  REMINDER
  MEETING
  SYSTEM
  AI
}

enum NotificationChannel {
  IN_APP
  TELEGRAM
  WEB_PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
  CANCELLED
}

enum FileStorageProvider {
  LOCAL
  S3
}

enum FileSource {
  UPLOAD
  GOOGLE_DRIVE
  TELEGRAM
  SYSTEM
}

enum FileStatus {
  ACTIVE
  PROCESSING
  FAILED
  DELETED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  avatarUrl           String?
  role                UserRole             @default(USER)
  status              UserStatus           @default(ACTIVE)
  timezone            String               @default("UTC")
  language            String               @default("en")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  tasks               Task[]
  reminders           Reminder[]
  meetings            Meeting[]
  notes               Note[]
  conversations       Conversation[]
  memories            UserMemory[]
  contacts            Contact[]
  aiUsage             AiUsage[]
  activityLogs        ActivityLog[]
  financeTransactions FinanceTransaction[]
  financeCategories   FinanceCategory[]
  telegramConnection  TelegramConnection?
  googleConnection    GoogleConnection?
  notifications        Notification[]
  notificationPreference NotificationPreference?
  files               UserFile[]
  fileFolders         FileFolder[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([role, status])
}

model FileFolder {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  name      String       @db.VarChar(200)
  parentId  String?      @db.Uuid
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    FileFolder?  @relation("FileFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  FileFolder[] @relation("FileFolderTree")
  files     UserFile[]

  @@unique([userId, parentId, name])
  @@index([userId, parentId])
}

model UserFile {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @db.Uuid
  originalName    String               @db.VarChar(255)
  storedName      String               @db.VarChar(255)
  label           String?              @db.VarChar(200)
  mimeType        String               @db.VarChar(200)
  extension       String?              @db.VarChar(20)
  sizeBytes       BigInt
  storageProvider FileStorageProvider  @default(LOCAL)
  storageKey      String               @db.VarChar(1000)
  folderId        String?              @db.Uuid
  source          FileSource            @default(UPLOAD)
  status          FileStatus            @default(ACTIVE)
  checksum        String?              @db.Char(64)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder          FileFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([userId, folderId])
  @@index([userId, mimeType])
  @@index([userId, source])
  @@index([userId, checksum])
  @@index([createdAt])
}

model GoogleConnection {
  id                     String                 @id @default(uuid()) @db.Uuid
  userId                 String                 @unique @db.Uuid
  googleUserId           String?
  email                  String?
  displayName            String?
  encryptedAccessToken   String?
  encryptedRefreshToken  String?
  accessTokenExpiresAt   DateTime?
  scopes                 String[]               @default([])
  status                 GoogleConnectionStatus @default(DISCONNECTED)
  connectedAt            DateTime?
  lastUsedAt             DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model TelegramConnection {
  id                    String                   @id @default(uuid()) @db.Uuid
  userId                String                   @unique @db.Uuid
  telegramUserId        String?
  // Encrypted compact payload; never a plaintext phone number.
  phoneNumber           String?
  username              String?                  @db.VarChar(100)
  displayName           String?                  @db.VarChar(200)
  encryptedSession      String?
  encryptedPhoneCodeHash String?
  // Bookkeeping for resend-code flood/timeout enforcement; never the code itself.
  codeSentAt            DateTime?
  codeResendAfterSeconds Int?
  status                TelegramConnectionStatus @default(DISCONNECTED)
  connectedAt           DateTime?
  lastValidatedAt       DateTime?
  lastErrorAt           DateTime?
  lastErrorCode         String?                  @db.VarChar(100)
  lastUsedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model RefreshToken {
  id               String    @id @default(uuid()) @db.Uuid
  tokenHash        String
  // Deterministic lookup key avoids bcrypt-scanning every active session.
  // Nullable keeps refresh compatibility with rows created before this migration.
  tokenFingerprint String?   @db.Char(64)
  userId           String    @db.Uuid
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, tokenFingerprint, revokedAt, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  tokenFingerprint String   @db.Char(64)
  tokenHash       String
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFingerprint])
  @@index([expiresAt])
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  title       String       @db.VarChar(200)
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, dueDate])
  @@index([userId, createdAt])
}

model Reminder {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  title       String         @db.VarChar(200)
  description String?        @db.Text
  remindAt    DateTime
  status      ReminderStatus @default(ACTIVE)
  priority    TaskPriority   @default(MEDIUM)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, remindAt])
  @@index([userId, priority])
}

model Meeting {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @db.Uuid
  title                 String        @db.VarChar(200)
  description           String?       @db.Text
  participant           String?       @db.VarChar(200)
  location              String?       @db.VarChar(500)
  startsAt              DateTime
  endsAt                DateTime
  reminderMinutesBefore Int           @default(15)
  status                MeetingStatus @default(SCHEDULED)
  contactId             String?       @db.Uuid
  googleCalendarEventId String?       @db.VarChar(1024)
  googleCalendarId      String?       @db.VarChar(200)
  googleSyncedAt        DateTime?
  googleSyncError       String?       @db.VarChar(100)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact               Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@index([userId, status])
  @@index([userId, contactId, startsAt])
  @@unique([userId, googleCalendarEventId])
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String   @db.VarChar(200)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId String?  @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, contactId, updatedAt])
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String    @db.VarChar(200)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole  @default(USER)
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model UserMemory {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  type       MemoryType @default(CONTEXT)
  key        String     @db.VarChar(100)
  value      String     @db.Text
  importance Int        @default(5)
  source     String     @default("MANUAL") @db.VarChar(100)
  contactId  String?    @db.Uuid
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  lastUsedAt DateTime?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact    Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([userId, key])
  @@index([userId, type])
  @@index([userId, contactId])
  @@index([userId, createdAt])
  @@index([userId, lastUsedAt])
}

model Contact {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @db.Uuid
  firstName           String               @db.VarChar(100)
  lastName            String?              @db.VarChar(100)
  displayName         String               @db.VarChar(200)
  phone               String?              @db.VarChar(50)
  email               String?              @db.VarChar(320)
  telegramUsername    String?              @db.VarChar(100)
  company             String?              @db.VarChar(200)
  position            String?              @db.VarChar(200)
  notes               String?              @db.Text
  tags                String[]             @default([])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetings            Meeting[]
  memories            UserMemory[]
  notesRelation       Note[]
  financeTransactions FinanceTransaction[]

  @@index([userId])
  @@index([displayName])
  @@index([phone])
  @@index([email])
  @@index([telegramUsername])
  @@index([userId, displayName])
  @@index([userId, phone])
  @@index([userId, email])
  @@index([userId, telegramUsername])
}

model FinanceCategory {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  name         String               @db.VarChar(100)
  type         FinanceCategoryType
  icon         String?              @db.VarChar(100)
  color        String?              @db.VarChar(30)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@unique([userId, name, type])
  @@index([userId])
  @@index([userId, type])
}

model FinanceTransaction {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @db.Uuid
  type            FinanceTransactionType
  amount          Decimal                @db.Decimal(18, 2)
  currency        FinanceCurrency
  categoryId      String?                @db.Uuid
  title           String                 @db.VarChar(200)
  description     String?                @db.Text
  transactionDate DateTime
  contactId       String?                @db.Uuid
  source          String?                @db.VarChar(100)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        FinanceCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contact         Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, transactionDate])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@index([userId, currency])
  @@index([userId, currency, transactionDate])
}

model AiUsage {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  type          UsageType
  model         String?   @db.VarChar(100)
  inputTokens   Int       @default(0)
  outputTokens  Int       @default(0)
  audioSeconds  Float     @default(0)
  estimatedCost Float     @default(0)
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, createdAt])
  @@index([createdAt, type])
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
}

model Notification {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @db.Uuid
  type          NotificationType
  title         String               @db.VarChar(200)
  message       String               @db.Text
  entityType    String?              @db.VarChar(100)
  entityId      String?              @db.Uuid
  channel       NotificationChannel
  status        NotificationStatus   @default(PENDING)
  scheduledAt   DateTime?
  sentAt        DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  metadata      Json?
  retryCount    Int                  @default(0)
  nextRetryAt   DateTime?
  claimedAt     DateTime?
  claimToken    String?              @db.VarChar(100)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([status, scheduledAt])
  @@index([entityType, entityId])
  @@index([userId, entityType, entityId, channel, status])
  @@index([createdAt, status])
}

model NotificationPreference {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @unique @db.Uuid
  taskEnabled              Boolean  @default(true)
  reminderEnabled          Boolean  @default(true)
  meetingEnabled           Boolean  @default(true)
  aiEnabled                Boolean  @default(false)
  telegramEnabled         Boolean  @default(false)
  webPushEnabled           Boolean  @default(false)
  defaultMeetingMinutesBefore Int    @default(15)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlatformSettings {
  id                  String   @id @default("global")
  name                String   @default("Qulay AI") @db.VarChar(100)
  registrationEnabled Boolean  @default(true)
  updatedBy           String?  @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
