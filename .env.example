DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yechim_ai?schema=public
NODE_ENV=production
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-64-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret-at-least-64-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
AUTH_TIMING_LOGS=false
PASSWORD_RESET_EXPIRES_MINUTES=30
PORT=3000
FRONTEND_URL=https://qulay-ai.vercel.app
# Optional Telegram integration (set all three together)
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=replace-with-telegram-api-hash
# TELEGRAM_SESSION_ENCRYPTION_KEY=replace-with-64-hex-characters
# Optional Google integration (set all four together)
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# GOOGLE_REDIRECT_URI=https://api.example.com/api/integrations/google/callback
# GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_PATH=./uploads
FILE_MAX_SIZE_MB=20
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
