DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yechim_ai?schema=public
NODE_ENV=production
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-64-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret-at-least-64-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
AUTH_TIMING_LOGS=false
PASSWORD_RESET_EXPIRES_MINUTES=30
PORT=3000
FRONTEND_URL=https://qulay-ai.vercel.app
# Optional Telegram integration (set all three together)
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=replace-with-telegram-api-hash
# TELEGRAM_SESSION_ENCRYPTION_KEY=replace-with-64-hex-characters
# Temporary admin-only Render diagnostic. Enable only for one manual check.
# TELEGRAM_LOGIN_DIAGNOSTIC_ENABLED=false
# TEST_TELEGRAM_PHONE=+998901234567
# Optional Google integration (set all four together)
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# GOOGLE_REDIRECT_URI=https://api.example.com/api/integrations/google/callback
# GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
# Required in production (validated at boot); optional in development/test
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=45000
# Password reset email (use noop locally, resend in production)
EMAIL_PROVIDER=noop
# RESEND_API_KEY=re_replace_me
# EMAIL_FROM=Qulay AI <noreply@example.com>
# Optional error monitoring
# SENTRY_DSN=https://public-key@sentry-host/project-id
# Optional secure wake endpoint for Telegram reminders on sleeping/free hosts
# NOTIFICATION_CRON_SECRET=replace-with-at-least-32-random-characters
# Optional secure wake endpoint for morning/evening briefing + proactive agent tick.
# Falls back to NOTIFICATION_CRON_SECRET if unset, so this is only needed if you
# want a separate secret for the agent scheduler's internal/agent-scheduler/tick route.
# AGENT_CRON_SECRET=replace-with-at-least-32-random-characters
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_PATH=./uploads
FILE_MAX_SIZE_MB=20
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Voice: same server-side OPENAI_API_KEY; no key is exposed to the browser.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Optional: enables low-latency WebRTC turn detection/transcription. Set only to a model enabled for your account.
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=marin
